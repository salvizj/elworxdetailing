---
interface Props {
	t: (key: string) => string
}

const { t } = Astro.props as Props
const address = "Rīgas-Siguldas šoseja 3B, Rīga, LV-1024, Latvija"
---

<div
	class="flex flex-col items-center justify-center px-4 mt-8 max-w-xl mx-auto text-center mb-8"
>
	<h3>
		{t("location_header")}
	</h3>

	<address
		class="not-italic leading-relaxed break-normal text-text-secondary text-base mt-2"
	>
		{address}
	</address>
</div>

<div class="flex justify-center w-full">
	<iframe
		width="100%"
		height="350"
		src="https://www.openstreetmap.org/export/embed.html?bbox=24.287874698638916%2C57.00473932613609%2C24.290385246276855%2C57.00582603360612&layer=mapnik&marker=57.00528268383922%2C24.289129972457886"
		style="border: 1px solid black"
		title="elworxdetailing Auto Detailing location"
		loading="lazy"></iframe>
</div>
