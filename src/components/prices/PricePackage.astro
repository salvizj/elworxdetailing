---
import { type PackagesContainer } from "~/utils/types"

interface Props {
	pricePackagesContainer: PackagesContainer
}

const { pricePackagesContainer } = Astro.props as Props

const { title, ...packages } = pricePackagesContainer
---

<div>
	<h2 class="text-3xl font-bold mb-8 text-text-primary">{title}</h2>

	{
		Object.entries(packages).map(([_, pkg]) => (
			<div class="mb-10 p-5 sm:p-6 rounded-xl bg-bg-card border border-border-muted shadow-sm hover:shadow-md transition-shadow duration-200">
				<h3 class="text-2xl font-semibold mb-4 text-text-primary">
					{pkg.title}
				</h3>
				<ul class="space-y-4">
					{pkg.services.map((service, _) => (
						<li class="flex flex-col sm:flex-row justify-start sm:justify-between items-start sm:items-center gap-4 sm:gap-6">
							<div class="flex-1 min-w-0 max-w-full">
								<p class="text-text-primary font-medium">{service.title}</p>
								{service.description && (
									<p class="mt-1 text-text-secondary">{service.description}</p>
								)}
							</div>
						</li>
					))}
				</ul>
				{pkg.price && (
					<p class="mt-4 font-bold text-accent text-right text-lg sm:text-xl">
						{pkg.price}
					</p>
				)}
			</div>
		))
	}
</div>
