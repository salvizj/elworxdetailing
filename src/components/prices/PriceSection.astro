---
import type { PriceSection } from "~/utils/types"

interface Props {
	priceSection: PriceSection
}

const { priceSection } = Astro.props
---

{
	priceSection && (
		<div class="mb-12">
			<h3 class="mb-6 text-2xl font-semibold text-text-primary">
				{priceSection.title}
			</h3>
			<ul class="space-y-4">
				{priceSection.services.map((item, index) => (
					<li class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 sm:gap-6 p-4 sm:p-6 rounded-xl bg-bg-card border border-border-muted shadow-sm hover:shadow-md transition-shadow duration-200">
						<div class="flex-1 min-w-0">
							<p class="text-text-primary font-medium">{item.title}</p>
							{item.description && (
								<p class="mt-1 text-text-secondary">{item.description}</p>
							)}
						</div>
						{item.price && (
							<p class="text-accent font-bold text-lg sm:text-xl whitespace-nowrap mt-2 sm:mt-0">
								{item.price}
							</p>
						)}
					</li>
				))}
			</ul>
		</div>
	)
}
