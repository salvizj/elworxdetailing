---
import { defaultLanguageCode } from "~/locales"
import Layout from "~/layouts/Layout.astro"
import { getMetaData } from "~/utils/metaData"

const meta = getMetaData(defaultLanguageCode)
const redirectUrl = `/${defaultLanguageCode}/`
const redirectScript = `window.location.replace(${JSON.stringify(redirectUrl)});`
---

<Layout
	languageCode={defaultLanguageCode}
	title={meta.title}
	description={meta.description}
	keywords={meta.keywords}
>
	<head slot="head">
		<meta http-equiv="refresh" content={`0; url=${redirectUrl}`} /><meta
			name="google-site-verification"
			content="89NZBfWq84OVkP3AxD50M8V4x_wQA-Z15ypiPgB7oSk"
		/>
	</head>
	<script is:inline set:html={redirectScript} />

	<p>Redirecting to your preferred language page...</p>
</Layout>
